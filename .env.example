# --- Core --------------------------------------------------------------
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-secret

# --- Database (PostgreSQL + asyncpg) -----------------------------------
DATABASE_URL=postgresql+asyncpg://payment:payment@localhost:5432/payment_gateway

# --- Redis (idempotency, rate-limiting, Celery broker/backend) ---------
REDIS_URL=redis://localhost:6379/0
REDIS_IDEMPOTENCY_DB=1
REDIS_RATELIMIT_DB=2

# --- JWT / Security ----------------------------------------------------
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
# Salt used to derive hashed API keys / secrets before storing in DB.
API_KEY_SALT=change-me-to-a-random-salt

# --- Celery -------------------------------------------------------------
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_WEBHOOK_MAX_RETRIES=5
CELERY_WEBHOOK_RETRY_BACKOFF=30

# --- UPI / PSP sandbox mock ---------------------------------------------
UPI_BANK_CALLBACK_URL=https://mock.psp.example/v1/webhooks/bank-callback
WEBHOOK_DEFAULT_BASE_URL=https://merchant.example/webhook
WEBHOOK_VERIFY_TOLERANCE_SECONDS=300
PSP_WEBHOOK_SECRET=change-me-psp-webhook-secret
MERCHANT_WEBHOOK_SECRET=change-me-merchant-webhook-secret
